{
  "expo": {
    "name": "كرم | Karam",
    "slug": "karam-auction",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0A0A0C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.karam.auction"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C"
      },
      "package": "com.karam.auction"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ]
  }
}
