# ==== لبيه (Labbeih) - إعدادات البيئة للباك إند ====

# منفذ التطبيق (لا تصادم مع radd.pro الشغال بالسيرفر)
PORT=3005
NODE_ENV=development

# قاعدة البيانات PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=labbeih
PGUSER=labbeih_user
PGPASSWORD=change_me

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# OTP (Mock بالتطوير - يطبع الكود بالـ console بدل ما يرسله فعلياً)
OTP_MODE=mock
OTP_TTL_SECONDS=300
# لاحقاً عند ربط مزود SMS حقيقي (مثال: Unifonic / Taqnyat):
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=Labbeih

# الأصل المسموح له بالاتصال (رابط الفرونت إند)
CORS_ORIGIN=http://localhost:5173

# رفع/تخزين المقاطع الصوتية
AUDIO_UPLOAD_DIR=uploads/voice
FREE_PLAN_RETENTION_HOURS=24

# Moyasar (المرحلة 3 - جهّز فقط، لا تُفعّل الآن)
MOYASAR_API_KEY=
MOYASAR_WEBHOOK_SECRET=
